# Applies to every image build using the repo root as context (node-backend
# and db-init — see their Dockerfiles for why each needs root context).
# NOTE: db-init also needs database/ and scripts/, so those are NOT excluded
# here even though node-backend itself doesn't use them.

.git/
.gitignore
node-backend/node_modules/
node-backend/.env
node-backend/certs/
node-backend/uploads/
node-backend/config/
# Dev-only synthetic eDelphyn test fixtures (hardcoded dev machine name +
# plaintext test credentials in setup_test_edelphyn.sql) — never bake these
# into a production image / offline release. See database/sqlserver/ for
# the actual shippable database package; this is not part of it.
node-backend/edelphyn-test-db/
python-service/venv/
python-service/__pycache__/
# rag-chatbot build-time cruft -- not excluded from .dockerignore before
# this (it has no rag-chatbot/* rules at all), so a locally-run
# refresh_data.py could otherwise bake a stale local chroma_db/data_snapshot
# into the rag-chatbot image, and venv/__pycache__ would bloat every build's
# context unnecessarily.
rag-chatbot/venv/
rag-chatbot/__pycache__/
rag-chatbot/chroma_db/
rag-chatbot/data_snapshot/
docs/
release/
*.md
.vscode/
