# Template for the Offline Environment deployment. Copy to .env on the
# offline Debian Docker host and fill in real values before running
# release/scripts/install_offline.sh — see release/documentation/INSTALL_OFFLINE.md.
#
# Same variable names as .env.example — the Docker images are identical
# between Online and Offline; only these values differ (RAH Lab's
# "Build Once, Deploy Anywhere" principle).

# ── Database (SQL Server) ────────────────────────────────────────
DB_SERVER=sqlserver
# DB_PORT is the HOST-side port only (external tools like DBeaver/SSMS) —
# app-to-app traffic stays on Docker's internal network regardless of this
# value, so changing it is always safe. 1433 is the SQL Server default, but
# on a shared offline host already running another project's own SQL
# Server container (common per RAH Lab's multi-project-per-VM pattern),
# 1433 will already be taken. Before first install, check with:
#   for port in 1433 80 443; do
#     (echo > /dev/tcp/127.0.0.1/$port) 2>/dev/null && echo "$port: IN USE" || echo "$port: free"
#   done
# and pick a free port here if 1433 collides — see TROUBLESHOOTING.md.
DB_PORT=1433
DB_NAME=BloodBankDB
DB_USER=bloodbank_user
DB_PASSWORD=

# sa password for the offline SQL Server container — set once at first
# install, keep it recorded in the hospital's approved credential store,
# not in this file once filled in.
DB_SA_PASSWORD=

# ── Backend ───────────────────────────────────────────────────────
JWT_SECRET=
WHISPER_SERVICE_URL=http://whisper:5001/transcribe

# ── Whisper (Speech-to-Text) ─────────────────────────────────────
# Re-confirm this against the OFFLINE server's actual available RAM/cores —
# do not assume it matches the Online Build Workstation's specs.
WHISPER_MODEL=medium

# ── eDelphyn (hospital's existing Laboratory Information System) ──
# Optional, separate, read-only SQL Server connection — NOT a container in
# this deployment's docker-compose.yml. Fill these in only if this hospital
# site has eDelphyn and the offline server can reach it on the network;
# otherwise leave blank. The app connects lazily and degrades gracefully
# (Settings page will show "not connected"), it does not block startup.
EDELPHYN_DB_SERVER=
EDELPHYN_DB_PORT=1433
EDELPHYN_DB_NAME=eDelphyn
EDELPHYN_DB_USER=
EDELPHYN_DB_PASSWORD=

# Leave unset. Database credentials for this deployment are managed through
# this file only — see the RUNTIME_SETTINGS_ENABLED comment in
# node-backend/settingsStore.js for why the Settings page's credential-save
# is intentionally disabled on the offline server.
# ALLOW_RUNTIME_DB_SETTINGS=true
