# Copy this file to .env and fill in real values. Never commit the filled-in
# .env — it's already in .gitignore alongside node-backend/.env.
#
# Every value here is read verbatim by docker-compose.yml, node-backend/db.js,
# and node-backend/server.js — no invented names, nothing hardcoded in code.

# ── Database (SQL Server) ────────────────────────────────────────
DB_SERVER=sqlserver
DB_PORT=1433
DB_NAME=BloodBankDB
DB_USER=bloodbank_user
DB_PASSWORD=

# sa password — used ONLY by the db-init service to bootstrap the DB_USER
# login and by scripts/backup_database.sql / restore_database.sql. Never
# read by node-backend itself. Must satisfy SQL Server's password
# complexity policy (8+ chars, upper+lower+digit or symbol).
DB_SA_PASSWORD=

# ── Backend ───────────────────────────────────────────────────────
# Sign/verify JWTs for auth. Generate a long random value — do not reuse
# the old in-code default ("bb-hospital-secret-2024-change-in-prod").
JWT_SECRET=

# Whisper service URL — the Compose service name resolves inside the
# Docker network; only change this if you rename the "whisper" service.
WHISPER_SERVICE_URL=http://whisper:5001/transcribe

# ── Whisper (Speech-to-Text) ─────────────────────────────────────
# "medium" needs ~1.5GB+ resident RAM at load time; "small" needs ~0.5GB.
# Confirm available RAM on the actual deployment host before using "medium"
# alongside SQL Server + the Node backend running concurrently.
WHISPER_MODEL=medium
