# Environment variables — never commit these
node-backend/.env
.env

# Admin-editable DB credentials saved from the Settings page — never commit
node-backend/config/

# Dependencies
node-backend/node_modules/
python-service/venv/
rag-chatbot/venv/
rag-chatbot/__pycache__/

# Regenerable build artifacts (rebuild with refresh_data.py) -- not source,
# and data_snapshot/ is a live pull from e-Delphyn so shouldn't be
# committed on principle even though this test data happens to be synthetic
rag-chatbot/chroma_db/
rag-chatbot/data_snapshot/

# Uploaded audio files
node-backend/uploads/

# OS files
.DS_Store
Thumbs.db

# TLS certs and local DB backups — generated per-deployment, never commit
nginx/certs/*.pem
release/*/compose/nginx/certs/*.pem
/backups/
release/*/backups/*.bak

# Docker/release build output — versioned release folders (release/<version>/)
release/*/docker-images/*.tar

# Whisper model binaries — multi-GB, fetched/exported via scripts, never commit
assets/whisper-model-medium/*.bin
release/*/assets/*.zip
release/*/assets/whisper-model-medium/*.bin

# Ollama models — multi-GB content-addressable blob store, exported via
# scripts/export_ollama_models.sh, never commit. Unlike Whisper's export
# (which has a small-metadata/large-binary split worth partially tracking),
# every file under Ollama's model store is itself a large binary blob, so
# the whole directory is excluded rather than just the *.bin files.
assets/ollama-models/


# Packager output — fully generated, never hand-authored
/release_packager/
